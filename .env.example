# OpenAI API Key (server-side only — never commit real keys)
OPENAI_API_KEY=sk-your-key-here

# GPT model (default: gpt-4.1-nano — fastest & cheapest)
OPENAI_MODEL=gpt-4.1-nano

# Upstash Redis — 서부 명부(세계 랭킹)용
# Vercel Marketplace: `npx vercel integration add upstash/upstash-kv`
# 로컬: `npx vercel env pull .env.local` 후 vercel dev 사용
# Redis.fromEnv()는 아래 이름(KV_*) 또는 UPSTASH_REDIS_* 모두 인식
KV_REST_API_URL=https://your-redis.upstash.io
KV_REST_API_TOKEN=your-token-here
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
